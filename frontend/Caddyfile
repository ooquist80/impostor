# PROTOCOL=https (default) or http, from .env.
# With https: TLS_MODE=internal -> Caddy's own CA (LAN), TLS_MODE=acme -> Let's Encrypt (public domain).

{
	# The container listens on the same ports as the host. The http -> https
	# redirect listens on http_port. https_port is left at its default (443) on
	# purpose: Caddy leaves that port out of redirect URLs, so setting it to
	# HTTPS_PORT would drop a non-default port from the redirect.
	http_port {$HTTP_PORT}

	# Browsers send no SNI when SITE_ADDRESS is an IP, and behind Docker's NAT
	# Caddy can't match the certificate by the local address either.
	default_sni {$SITE_ADDRESS}
}

(app) {
	encode gzip zstd

	# PWA: the service worker and manifest are always revalidated, so a new
	# version is found on the next visit. Built assets have hashed names.
	header /sw.js Cache-Control "no-cache"
	header /manifest.webmanifest Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# One site per PROTOCOL/TLS_MODE pair; the import below picks one.
# The port is part of the address so the http -> https redirect includes it.
(site_https_internal) {
	https://{$SITE_ADDRESS}:{$HTTPS_PORT} {
		tls internal
		import app
	}
}

(site_https_acme) {
	https://{$SITE_ADDRESS}:{$HTTPS_PORT} {
		import app
	}
}

# Plain HTTP: no certificate, whatever TLS_MODE says.
(site_http_internal) {
	http://{$SITE_ADDRESS}:{$HTTP_PORT} {
		import app
	}
}

(site_http_acme) {
	import site_http_internal
}

import site_{$PROTOCOL}_{$TLS_MODE}
