# Copy to .env and edit: cp .env.example .env
# .env is gitignored. Keep it private.

# --- Web (Caddy) ---------------------------------------------------------
# Hostname or IP that players open in their browser. Caddy issues the
# certificate for it. Examples: raspberrypi.local, 192.168.1.50, game.example.com
SITE_ADDRESS=localhost

# internal = Caddy's own certificate authority, for use on a LAN (default).
#            Each phone shows a certificate warning the first time.
# acme     = Let's Encrypt, for a public domain in SITE_ADDRESS.
TLS_MODE=internal

# Ports published by the web service.
# Limits of non-default ports (documented, not handled in code):
#  - With an HTTPS_PORT other than 443, players open https://<SITE_ADDRESS>:<HTTPS_PORT>.
#  - The automatic http -> https redirect assumes 443. With other ports, players
#    must type the https:// address including the port.
#  - TLS_MODE=acme (Let's Encrypt) requires HTTP_PORT=80 and HTTPS_PORT=443,
#    reachable from the internet.
HTTP_PORT=80
HTTPS_PORT=443

# --- Database (MariaDB) --------------------------------------------------
# Root password of the database. Choose a long random value.
MARIADB_ROOT_PASSWORD=change-me-root

# Application database and user, used by both the db and backend services.
MARIADB_DATABASE=impostor
MARIADB_USER=impostor
MARIADB_PASSWORD=change-me

# Localhost-only port for the database, for native development
# (backend run with uvicorn / alembic outside Docker). Not reachable from the LAN.
DB_PORT=3306

# --- Backend -------------------------------------------------------------
# Key used to sign login and QR tokens. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=
